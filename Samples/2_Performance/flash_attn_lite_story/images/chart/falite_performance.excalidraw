      "x": 160,
      "y": 800,
      "width": 1250,
      "height": 26.0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 7367,
      "version": 1,
      "versionNonce": 8367,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "index": "a7367",
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "v7 -> v8 的变化约 0.08%，可视为持平；v10 -> v11 小于 0.5%，继续增加提前发射的轮数已很难缩短耗时。",
      "originalText": "v7 -> v8 的变化约 0.08%，可视为持平；v10 -> v11 小于 0.5%，继续增加提前发射的轮数已很难缩短耗时。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    }
